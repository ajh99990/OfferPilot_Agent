# LangChain Agent Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# OpenAI-compatible model provider (required)
# ============================================

# API key for your OpenAI-compatible provider / proxy
OPENAI_API_KEY=your-openai-compatible-api-key-here

# Base URL for the OpenAI-compatible provider
# Example: https://api.example.com/v1
OPENAI_BASE_URL=https://api.example.com/v1

# Model name exposed by your provider
OPENAI_MODEL=gpt-5.4

